{
  "name": "collocation-srs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Интервальное повторение английских коллокаций",
  "scripts": {
    "decks": "node scripts/sync-decks.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "npm run decks",
    "dev": "vite",
    "start": "npm run build && vite preview --open",
    "serve": "vite preview --open",
    "prebuild": "npm run decks",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
