@echo off
rem ============================================================
rem  Запуск приложения. Файл можно открыть двойным щелчком или
rem  вынести ярлык на рабочий стол.
rem
rem  Что происходит: собирается свежая версия и поднимается
rem  локальный сервер на порту 5173, после чего открывается
rem  браузер. Окно консоли нужно держать открытым — закрытие
rem  останавливает сервер.
rem
rem  Установив приложение как программу (в адресной строке
rem  Chrome появляется значок установки), запускать этот файл
rem  каждый раз не нужно: установленное приложение работает из
rem  собственного кэша и без сервера.
rem ============================================================
chcp 65001 >nul
cd /d "%~dp0app"

if not exist node_modules (
  echo Первый запуск: устанавливаю зависимости, это займёт минуту...
  call npm install || goto :err
)

echo Собираю приложение...
call npm run build || goto :err

echo.
echo Открываю http://localhost:5173
echo Чтобы остановить — закройте это окно.
echo.
call npm run serve || goto :err
goto :eof

:err
echo.
echo Не получилось. Ошибка напечатана выше.
pause
